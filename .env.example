LOG_LEVEL=INFO

# Listener
LISTENER_HOST=0.0.0.0
LISTENER_PORT=1799
LISTENER_BUFFER=2048
STORE_TYPES=msg,pos,tele,status,ack

# Database
DB_BACKEND=sqlite
DB_SQLITE_PATH=/data/meshcom.db
DB_RETENTION_DAYS=7

# Reserved SurrealDB settings
DB_URL=ws://surrealdb:8000
DB_USER=root
DB_PASS=root
DB_NS=meshcom
DB_DB=listener

# Notifications via Apprise API
NOTIFY_ENABLED=true
APPRISE_URL=http://apprise:8000/notify
NOTIFY_TARGETS=

# Forwarding filters
FORWARD_TYPES=msg,pos
FORWARD_INCLUDE_DST=
FORWARD_EXCLUDE_DST=*
FORWARD_EXCLUDE_SRC=
